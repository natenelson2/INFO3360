# .env.example — SAFE TO COMMIT. Copy to .env.local and fill real values.
# Never put real production secrets in this file or in git.
#
# Aligns with docs/client-vs-server-inventory.md:
#   PUBLIC  = may reach the browser (VITE_ prefix only)
#   SECRET  = server-only (NO VITE_ prefix)

# -----------------------------------------------------------------------------
# PUBLIC (may be exposed to the browser bundle via the VITE_ prefix)
# Use these only for values that are designed to be public (Supabase project
# URL + anon/public key). Protect data with Row Level Security on the database.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SECRET (server-only — NO VITE_ prefix)
# Vite must not embed these into client JavaScript. Read them only from
# server modules (TanStack Start server functions, *.server.ts, etc.).
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Optional: server-side label for logs (not a secret; still keep off VITE_ if
# you do not need it in the browser)
# APP_ENV=development