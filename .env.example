# .env.example — SAFE TO COMMIT. Copy to .env.local and fill real values.
# Never put real production secrets in this file or in git.
#
# Aligns with docs/security/auth-session-plan.md and docs/client-vs-server-inventory.md:
#   PUBLIC  = may reach the browser (VITE_ prefix only)
#   SECRET  = server-only (NO VITE_ prefix)

# -----------------------------------------------------------------------------
# PUBLIC (may be exposed to the browser bundle via the VITE_ prefix)
# Use these only for values that are designed to be public (Supabase project
# URL + anon/public key). Protect data with Row Level Security on the database.
# Browser client: src/lib/supabase/client.ts
# Server session client also reads these (or SUPABASE_URL / SUPABASE_ANON_KEY).
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional server-side aliases for the same public values (no VITE_ required).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key

# -----------------------------------------------------------------------------
# SECRET (server-only — NO VITE_ prefix)
# Vite must not embed these into client JavaScript. Read them only from
# server modules (for example app/lib/supabase.server.ts).
# NEVER import the service-role key into src/lib/supabase/client.ts.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-use-in-browser

# Optional: server-side label for logs (not a secret; still keep off VITE_ if
# you do not need it in the browser)
# APP_ENV=development